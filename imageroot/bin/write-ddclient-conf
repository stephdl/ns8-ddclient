#
# Render config/ddclient.conf from the module environment, password.env and
# etc/protocols.json. The host entry carries only the variables the selected
# protocol declares in ddclient 4.0.0.
#

import os
import re
import sys

import ddclient_protocols as dp

SAFE_VALUE = re.compile(r"[A-Za-z0-9._:/@+-]+")


def quote(value):
    if SAFE_VALUE.fullmatch(value):
        return value
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def host_entry():
    protocol = os.getenv("DDCLIENT_PROTOCOL", "")
    host = os.getenv("DDCLIENT_HOST", "")
    if not host:
        return []
    values = dp.entry_values(protocol, host, os.environ, dp.read_secrets())
    error = dp.entry_error(protocol, host, values)
    if error:
        # Not a failure of the unit: a non-zero exit here would also fail
        # update-module. get-configuration reports the same error to the UI
        reason = {
            "unsupported_protocol": f"protocol '{protocol}' is not supported by ddclient 4.0.0",
            "required": f"'{error['field']}' is required by protocol {protocol}",
            "invalid": f"'{error['field']}' cannot contain '#' or a newline",
            "root_domain": f"'{host}' does not end with the root domain",
        }[error["error"]]
        print(f"{reason}: {host} is not updated", file=sys.stderr)
        return []

    pdef = dp.load()[protocol]
    assignments = ["protocol=" + protocol, "server=" + quote(os.getenv("DDCLIENT_SERVER") or pdef["server"])]
    for var in pdef["vars"]:
        name = var["name"]
        if not values[name]:
            continue
        if var["secret"]:
            # The value stays in the container environment (--env-file), so
            # no character in it can break the configuration file
            assignments.append(f"{name}_env={dp.env_name(name)}")
        else:
            assignments.append(f"{name}={quote(values[name])}")
    return [a + ", \\" for a in assignments] + [host]


def main():
    lines = [
        "daemon=" + (os.getenv("DDCLIENT_DAEMON") or "300"),
        "pid=/var/run/ddclient/ddclient.pid",
        "ssl=yes",
        "usev4=webv4, webv4=api.ipify.org",
    ]
    if os.getenv("DDCLIENT_IPV6"):
        lines.append("usev6=webv6, webv6=api6.ipify.org")
    lines += host_entry()

    os.makedirs("config", exist_ok=True)
    with open("config/ddclient.conf", "w") as fp:
        fp.write("\n".join(lines) + "\n")


if __name__ == "__main__":
    main()
