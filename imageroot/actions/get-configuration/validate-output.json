{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Get ddclient settings",
  "$id": "http://nethserver.org/json-schema/task/input/ddclient/get-configuration",
  "description": "Get ddclient settings",
  "examples": [
    {
      "ddclient_host": "ddclient.domain.org",
      "ddclient_server": "ddclient.domain.org",
      "ddclient_login": "admin",
      "ddclient_password": "",
      "ddclient_protocol": "dyndns2",
      "ddclient_daemon": "300",
      "ddclient_ipv6": false,
      "ddclient_apikey": "",
      "ddclient_secretapikey": "",
      "ddclient_root_domain": "",
      "ddclient_stored_secrets": [
        "password"
      ]
    }
  ],
  "type": "object",
  "required": [
    "ddclient_host",
    "ddclient_server",
    "ddclient_login",
    "ddclient_password",
    "ddclient_protocol",
    "ddclient_daemon",
    "ddclient_ipv6",
    "ddclient_apikey",
    "ddclient_secretapikey",
    "ddclient_root_domain",
    "ddclient_stored_secrets"
  ],
  "properties": {
    "ddclient_daemon": {
      "type": "string",
      "description": "Enable ddclient daemon"
    },
    "ddclient_ipv6": {
      "type": "boolean",
      "description": "Enable ddclient ipv6"
    },
    "ddclient_host": {
      "description": "Host name for the application, like 'ddclient.domain.org' or an empty string",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^$"
        },
        {
          "type": "string",
          "format": "hostname",
          "pattern": "\\."
        }
      ]
    },
    "ddclient_server": {
      "description": "Host name for the api server, like 'ddclient.domain.org' or an empty string for the protocol default",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^$"
        },
        {
          "type": "string",
          "format": "hostname",
          "pattern": "\\."
        }
      ]
    },
    "ddclient_login": {
      "type": "string",
      "description": "Login for the api server"
    },
    "ddclient_password": {
      "type": "string",
      "description": "Always an empty string: the password is not sent back"
    },
    "ddclient_protocol": {
      "type": "string",
      "description": "Protocol for the api server"
    },
    "ddclient_apikey": {
      "type": "string",
      "description": "Always an empty string: the API key is not sent back"
    },
    "ddclient_secretapikey": {
      "type": "string",
      "description": "Always an empty string: the secret API key is not sent back"
    },
    "ddclient_root_domain": {
      "description": "Root domain of ddclient_host, for the porkbun protocol, or an empty string",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^$"
        },
        {
          "type": "string",
          "format": "hostname",
          "pattern": "\\."
        }
      ]
    },
    "ddclient_stored_secrets": {
      "type": "array",
      "description": "Secrets that have a stored value, so an empty field keeps them",
      "items": {
        "type": "string",
        "enum": [
          "password",
          "apikey",
          "secretapikey"
        ]
      }
    }
  }
}
