import agent
import ddclient_protocols as dp
import os

secrets = dp.read_secrets()

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "ddclient_host": os.environ["DDCLIENT_HOST"],
    "ddclient_login": os.getenv("DDCLIENT_LOGIN", ""),
    "ddclient_password": secrets["DDCLIENT_PASSWORD"],
    "ddclient_apikey": secrets["DDCLIENT_APIKEY"],
    "ddclient_secretapikey": secrets["DDCLIENT_SECRETAPIKEY"],
    "ddclient_protocol": os.environ["DDCLIENT_PROTOCOL"],
    "ddclient_server": os.environ["DDCLIENT_SERVER"],
    "ddclient_root_domain": os.getenv("DDCLIENT_ROOT_DOMAIN", ""),
    "ddclient_daemon": os.environ["DDCLIENT_DAEMON"],
    "ddclient_ipv6": os.environ["DDCLIENT_IPV6"] == "webv6",
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
