{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure ddclient",
    "$id": "http://nethserver.org/json-schema/task/input/ddclient/configure-module",
    "description": "Configure ddclient",
    "examples": [
        {
            "ddclient_host": "ddclient.domain.org",
            "ddclient_server": "ddclient.domain.org",
            "ddclient_login": "admin",
            "ddclient_password": "admin",
            "ddclient_protocol": "http",
            "ddclient_daemon": "300",
            "ddclient_ipv6": false
        }
    ],
    "type": "object",
    "required": [
        "ddclient_host",
        "ddclient_server",
        "ddclient_login",
        "ddclient_password",
        "ddclient_protocol",
        "ddclient_daemon",
        "ddclient_ipv6"
    ],
    "properties": {
        "ddclient_host": {
            "type": "string",
            "description": "Host name for the application, like 'ddclient.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "ddclient_server": {
            "type": "string",
            "description": "Host name for the api server, like 'ddclient.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "ddclient_login": {
            "type": "string",
            "description": "Login for the api server"
        },
        "ddclient_password": {
            "type": "string",
            "description": "Password for the api server"
        },
        "ddclient_protocol": {
            "type": "string",
            "description": "Protocol for the api server"
        },
        "ddclient_daemon": {
            "type": "string",
            "description": "Update interval in seconds the daemon waits between two checks, like '300'",
            "pattern": "^[0-9]+$"
        },
        "ddclient_ipv6": {
            "type": "boolean",
            "description": "Whether the IPv6 address is published alongside the IPv4 one"
        }
    }
}
