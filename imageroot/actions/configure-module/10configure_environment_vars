import json
import sys
import agent
import os

import ddclient_protocols as dp

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

protocol = data["ddclient_protocol"]
protocol_changed = protocol != os.getenv("DDCLIENT_PROTOCOL", "")

# A stored secret belongs to the protocol it was given for: after a switch,
# a dyndns2 password must not become a duckdns token. An empty or missing
# secret in the request keeps the stored one only for the same protocol.
secrets = dict.fromkeys(dp.SECRET_KEYS, "") if protocol_changed else dp.read_secrets()
for key in dp.SECRET_KEYS:
    value = data.get(key.lower(), "")
    if value != "":
        secrets[key] = value

# Only a protocol change is checked: restore and clone configure again the
# stored protocol, which may be one ddclient 4 dropped
if protocol_changed:
    environ = {
        "DDCLIENT_LOGIN": data.get("ddclient_login", ""),
        "DDCLIENT_ROOT_DOMAIN": data.get("ddclient_root_domain", ""),
    }
    error = None
    if protocol in dp.load():
        values = dp.entry_values(protocol, data["ddclient_host"], environ, secrets)
        error = dp.entry_error(protocol, data["ddclient_host"], values)
    else:
        error = {"error": "unsupported_protocol", "field": protocol}
    if error:
        field = "ddclient_protocol" if error["error"] == "unsupported_protocol" else "ddclient_" + error["field"].replace("-", "_")
        agent.set_status('validation-failed')
        json.dump([{'field': field, 'parameter': field, 'value': '', 'error': 'entry_' + error["error"]}], fp=sys.stdout)
        sys.exit(3)

agent.set_env("DDCLIENT_HOST", data["ddclient_host"])
agent.set_env("DDCLIENT_LOGIN", data.get("ddclient_login", ""))
agent.set_env("DDCLIENT_PROTOCOL", protocol)
agent.set_env("DDCLIENT_SERVER", data["ddclient_server"])
agent.set_env("DDCLIENT_ROOT_DOMAIN", data.get("ddclient_root_domain", ""))
agent.set_env("DDCLIENT_DAEMON", data["ddclient_daemon"])
agent.set_env("DDCLIENT_IPV6", "webv6" if data["ddclient_ipv6"] else "")

# Every key is written, even empty, so the file has one shape whatever the
# protocol
agent.write_envfile("password.env", secrets)
