import json
import sys
import agent
import os

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

agent.set_env("DDCLIENT_HOST", data["ddclient_host"])
agent.set_env("DDCLIENT_LOGIN", data.get("ddclient_login", ""))
agent.set_env("DDCLIENT_PROTOCOL", data["ddclient_protocol"])
agent.set_env("DDCLIENT_SERVER", data["ddclient_server"])
agent.set_env("DDCLIENT_ROOT_DOMAIN", data.get("ddclient_root_domain", ""))
agent.set_env("DDCLIENT_DAEMON", data["ddclient_daemon"])
agent.set_env("DDCLIENT_IPV6", "webv6" if data["ddclient_ipv6"] else "")

# Every key is written, even empty, so the file has one shape whatever the
# protocol. An empty or missing secret in the request keeps the stored one.
secrets = {
    "DDCLIENT_PASSWORD": "",
    "DDCLIENT_APIKEY": "",
    "DDCLIENT_SECRETAPIKEY": "",
}
if os.path.exists("password.env"):
    secrets.update(agent.read_envfile("password.env"))
for key in ["DDCLIENT_PASSWORD", "DDCLIENT_APIKEY", "DDCLIENT_SECRETAPIKEY"]:
    value = data.get(key.lower(), "")
    if value != "":
        secrets[key] = value
agent.write_envfile("password.env", secrets)
