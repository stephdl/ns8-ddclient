{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "regexManagers": [
    {
      "fileMatch": ["build-images.sh"],
      "matchStrings": ["docker\\.io/linuxserver/ddclient:(?<currentValue>v[0-9.]+-ls[0-9]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "linuxserver/ddclient",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    }
  ]
}
